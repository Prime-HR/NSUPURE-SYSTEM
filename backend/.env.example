# ==============================================================
# NSUPURE MINERAL WATER ENTERPRISE - CLOUD ENVIRONMENT VARIABLES
# ==============================================================

# Port configuration (Auto-provided by cloud hosts like Render)
PORT=5000
NODE_ENV=production

# Database URL:
# For Local Development (SQLite): file:./dev.db
# For Cloud Production (Neon / Supabase PostgreSQL):
# postgresql://<user>:<password>@<neon-subdomain>.neon.tech/neondb?sslmode=require
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret (Generate a strong random string in production)
JWT_SECRET="nsupure_production_secure_jwt_secret_key_2025"
JWT_EXPIRES_IN="7d"

# Initial Root Owner Password (Used on first system seeding)
INITIAL_OWNER_PASSWORD="Nsupure2025!"

# Upload Storage Directory
UPLOAD_DIR="./uploads"

# Allowed Frontend URL (or * for multiple mobile devices)
FRONTEND_URL="*"
DEFAULT_CURRENCY="GHS"
